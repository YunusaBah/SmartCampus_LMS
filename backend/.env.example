PORT=5000
# Local PostgreSQL (create this database in pgAdmin first).
DB_DIALECT=postgres
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcampus
DB_USER=postgres
DB_PASSWORD=change_this_to_your_local_postgres_password
# Local PostgreSQL does not require SSL. Use DB_SSL=true for Supabase.
DB_SSL=false
DB_SSL_CA_FILE=
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_CONNECT_TIMEOUT=15000
JWT_SECRET=change_this_to_a_long_random_secret
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
CLIENT_URL=http://localhost:5173
OPENAI_API_KEY=your_openai_api_key
TENOR_API_KEY=your_tenor_api_key

# Configure an SMTP provider to deliver feedback and collaboration messages.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FEEDBACK_RECIPIENT_EMAIL=bahy1878@gmail.com
COLLABORATION_RECIPIENT_EMAIL=yb22423255@utg.edu.gm

# For deployment, set DATABASE_URL to the Supabase PostgreSQL URI and DB_SSL=true
# in the hosting provider's environment settings. DATABASE_URL takes precedence
# over DB_HOST/DB_NAME/DB_USER/DB_PASSWORD.
