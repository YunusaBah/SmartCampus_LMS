NODE_ENV=development
PORT=5000

DB_DIALECT=postgres
DATABASE_URL=postgresql://<user>:<password>@<pooler-host>:6543/postgres
DB_SSL=true
# Only set this if the certificate file exists at this path on the machine running the backend:
DB_SSL_CA_FILE=<path-to-certificate>
# Keep per-instance connections low; use Supabase's transaction pooler for Vercel.
DB_POOL_MAX=1
DB_POOL_MIN=0

JWT_SECRET=<random-secret-at-least-32-characters>
CLIENT_URL=https://smartcampuslms.vercel.app

GOOGLE_CLIENT_ID=<google-oauth-client-id>
OPENAI_API_KEY=<openai-api-key>
TENOR_API_KEY=<tenor-api-key>

# Supabase Storage (service-role key is backend-only; never use it in the frontend).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=smartcampus-files

# Optional: enables Supabase Realtime chat updates; distinct from JWT_SECRET.
SUPABASE_JWT_SECRET=<supabase-jwt-secret>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<gmail-address>
SMTP_PASSWORD=<gmail-app-password>
SMTP_FROM=<gmail-address>

FEEDBACK_RECIPIENT_EMAIL=<feedback-recipient>
COLLABORATION_RECIPIENT_EMAIL=<collaboration-recipient>