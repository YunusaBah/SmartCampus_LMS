# For Vercel same-origin deployment, leave VITE_API_URL unset.
# For a separately hosted API, set its origin without a trailing slash.
# VITE_API_URL=
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id
# Public browser values only; never put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
